<!--
  7-DOF KUKA LWR4-like arm for reproducing
    F. Ficuciello, L. Villani, B. Siciliano, "Variable Impedance Control of Redundant
    Manipulators for Intuitive Human-Robot Physical Interaction", IEEE T-RO 31(4), 2015.

  Kinematics: LWR4 link lengths (base->J2 0.3105 m, J2->J4 0.40 m, J4->J6 0.39 m,
  J6->flange 0.078 m) + a 0.10 m paint marker. Joint axes in the zero (upright) pose:
      J1 z, J2 +y, J3 z, J4 -y, J5 z, J6 +y, J7 z
  which reproduces the LWR4 sign convention (q2>0, q4<0, q6>0 all tilt the arm forward),
  so the paper's start pose q_i = [2.35 22.8 -1.54 -53.2 -3.1 101.15 0] deg puts the
  pen vertically on the desk.

  Dynamics: approximate link masses/inertias (cylinder approximations, total ~15 kg).
  They are NOT identified LWR4 parameters; the end-effector apparent inertia they give
  is of the same order as the values reported in the paper (see README).

  Joint viscous friction (damping) is present in the "real" robot but unknown to the
  controller; it is picked up by the momentum observer, as in the paper.
-->
<mujoco model="lwr4_writing">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"/>

  <visual>
    <global offwidth="1280" offheight="720" azimuth="150" elevation="-25"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.82 0.82 0.85" rgb2="0.74 0.74 0.78"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.05"/>
    <material name="orange" rgba="0.95 0.45 0.1 1"/>
    <material name="grey" rgba="0.55 0.57 0.6 1"/>
    <material name="dark" rgba="0.15 0.15 0.17 1"/>
    <material name="wood" rgba="0.55 0.4 0.28 1"/>
  </asset>

  <default>
    <joint damping="0.5" armature="0"/>
    <geom contype="0" conaffinity="0"/>
    <default class="j_z"><joint axis="0 0 1" range="-170 170"/></default>
    <default class="j_y"><joint axis="0 1 0" range="-120 120"/></default>
    <default class="j_ny"><joint axis="0 -1 0" range="-120 120"/></default>
    <!-- robot geoms in group 1 so the top-down video camera can hide the arm -->
    <default class="robot"><geom group="1"/></default>
  </default>

  <worldbody>
    <light pos="0.4 -0.6 2.0" dir="-0.2 0.3 -1" directional="false" castshadow="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" pos="0 0 0" material="grid"/>

    <!-- robot stands on the floor next to a low desk; A4 sheet top surface at z = 0.5935,
         just under the pen tip at q_i (visual only: nothing collides) -->
    <geom name="desk" type="box" size="0.22 0.32 0.02" pos="0.50 0 0.5725" material="wood"/>
    <geom name="desk_leg1" type="box" size="0.02 0.02 0.276" pos="0.30 0.29 0.276" material="dark"/>
    <geom name="desk_leg2" type="box" size="0.02 0.02 0.276" pos="0.30 -0.29 0.276" material="dark"/>
    <geom name="desk_leg3" type="box" size="0.02 0.02 0.276" pos="0.70 0.29 0.276" material="dark"/>
    <geom name="desk_leg4" type="box" size="0.02 0.02 0.276" pos="0.70 -0.29 0.276" material="dark"/>
    <geom name="sheet" type="box" size="0.105 0.148 0.0005" pos="0.48 0 0.593" rgba="0.97 0.97 0.95 1"/>

    <body name="base" pos="0 0 0" childclass="robot">
      <geom type="cylinder" size="0.07 0.055" pos="0 0 0.055" material="grey"/>

      <body name="link1" pos="0 0 0.1105">
        <joint name="j1" class="j_z"/>
        <inertial pos="0 0 0.10" mass="2.7" diaginertia="0.0114 0.0114 0.0049"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.06" material="orange"/>

        <body name="link2" pos="0 0 0.2">
          <joint name="j2" class="j_y"/>
          <inertial pos="0 0 0.10" mass="2.7" diaginertia="0.0114 0.0114 0.0049"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.06" material="grey"/>

          <body name="link3" pos="0 0 0.2">
            <joint name="j3" class="j_z"/>
            <inertial pos="0 0 0.10" mass="2.5" diaginertia="0.0105 0.0105 0.0045"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.06" material="orange"/>

            <body name="link4" pos="0 0 0.2">
              <joint name="j4" class="j_ny"/>
              <inertial pos="0 0 0.10" mass="2.4" diaginertia="0.0100 0.0100 0.0043"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.06" material="grey"/>

              <body name="link5" pos="0 0 0.2">
                <joint name="j5" armature="0.005" class="j_z"/>
                <inertial pos="0 0 0.09" mass="1.7" diaginertia="0.0060 0.0060 0.0022"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.19" size="0.055" material="orange"/>

                <body name="link6" pos="0 0 0.19">
                  <joint name="j6" armature="0.005" class="j_y"/>
                  <inertial pos="0 0 0.0" mass="0.8" diaginertia="0.0015 0.0015 0.0010"/>
                  <geom type="sphere" size="0.06" material="grey"/>

                  <body name="link7" pos="0 0 0">
                    <joint name="j7" armature="0.005" class="j_z"/>
                    <inertial pos="0 0 0.06" mass="0.4" diaginertia="0.0004 0.0004 0.0003"/>
                    <geom type="cylinder" fromto="0 0 0.0 0 0 0.078" size="0.04" material="dark"/>
                    <!-- paint marker -->
                    <geom type="cylinder" fromto="0 0 0.078 0 0 0.168" size="0.009" rgba="0.1 0.3 0.9 1"/>
                    <geom type="sphere" pos="0 0 0.172" size="0.006" rgba="0.05 0.05 0.05 1" group="2"/>
                    <site name="pen" pos="0 0 0.178" size="0.004" rgba="1 0 0 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="m1" joint="j1"/>
    <motor name="m2" joint="j2"/>
    <motor name="m3" joint="j3"/>
    <motor name="m4" joint="j4"/>
    <motor name="m5" joint="j5"/>
    <motor name="m6" joint="j6"/>
    <motor name="m7" joint="j7"/>
  </actuator>
</mujoco>
